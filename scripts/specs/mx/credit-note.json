{
 "key": "credit-note",
 "export": "mxCfdiCreditNoteSpec",
 "title": "CFDI credit note (Egreso)",
 "format": "CFDI 4.0",
 "schema": "cfdv40.xsd",
 "errorPrefix": "GOBL-MX-CFDI-BILL-INVOICE-",
 "sections": [
  {
   "key": "differences",
   "title": "Differences from an invoice",
   "node": "cfdi:Comprobante",
   "intro": "All the other rows of the invoice spec apply without change.",
   "rows": [
    {
     "id": "MX-CRN-01",
     "cfdi": "@TipoDeComprobante",
     "req": "M",
     "format": "c_TipoDeComprobante",
     "gobl": "type",
     "send": "M",
     "rule": "Gives E.",
     "example": "E",
     "values": "credit-note.",
     "link": {
      "label": "bill.Invoice: type",
      "url": "https://docs.gobl.org/draft-0/bill/invoice"
     },
     "auto": false
    },
    {
     "id": "MX-CRN-02",
     "cfdi": "CfdiRelacionados/CfdiRelacionado/@UUID",
     "req": "C",
     "format": "UUID",
     "gobl": "preceding[].stamps (sat-uuid)",
     "send": "M",
     "rule": "One preceding row for each original invoice.",
     "example": "1fac4464-1111-0000-1111-cd37179db12e",
     "errors": [
      "17"
     ],
     "values": "Each preceding row needs code, issue_date and the sat-uuid stamp of the earlier CFDI.",
     "link": {
      "label": "org.DocumentRef",
      "url": "https://docs.gobl.org/draft-0/org/document_ref"
     },
     "auto": false
    },
    {
     "id": "MX-CRN-03",
     "cfdi": "CfdiRelacionados/@TipoRelacion",
     "req": "C",
     "format": "c_TipoRelacion",
     "gobl": "tax.ext.mx-cfdi-rel-type",
     "send": "O",
     "rule": "All the preceding rows share the code.",
     "example": "01",
     "errors": [
      "16"
     ],
     "values": "01 (credit note), 03 (return of goods) or 07 (application of an advance).",
     "default": "01",
     "link": {
      "label": "Addon: relation type",
      "url": "https://docs.gobl.org/addons/mx-cfdi-v4#relation-type"
     },
     "auto": true
    },
    {
     "id": "MX-CRN-04",
     "cfdi": "Concepto/@Cantidad, @ValorUnitario",
     "req": "M",
     "format": "Positive",
     "gobl": "lines[].quantity, lines[].item.price",
     "send": "M",
     "rule": "The document type tells the SAT that the amounts decrease the income.",
     "errors": [
      "21",
      "23"
     ],
     "values": "Positive values.",
     "link": {
      "label": "bill.Line",
      "url": "https://docs.gobl.org/draft-0/bill/line"
     },
     "auto": false
    }
   ]
  }
 ],
 "rules": []
}